      <stop offset="0" stop-color="#74f1ff"/>
      <stop offset="1" stop-color="#00e5ff"/>
    </linearGradient>
  </defs>
  <circle cx="80" cy="80" r="68" fill="#081426" stroke="url(#glow)" stroke-width="5"/>
  <circle cx="48" cy="51" r="8" fill="#ffd166"/>
  <circle cx="118" cy="45" r="5" fill="#ffd166"/>
  <path d="M38 78c0-20 16-36 36-36h12c20 0 36 16 36 36v18c0 20-16 36-36 36H74c-20 0-36-16-36-36V78Z" fill="none" stroke="url(#glow)" stroke-width="7"/>
