<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" role="img" aria-labelledby="title desc">
  <title id="title">Galaxy Gaming Hub logo</title>
  <desc id="desc">A cyan gaming headset inside a glowing galaxy ring.</desc>
